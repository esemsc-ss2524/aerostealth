FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent          yes;
}

solvers
{
    "(p|pa).*"   { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.01; }
    "(m|ma).*"   { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.01; }
    "(U|Ua|nuTilda|nuaTilda|yWall|da).*"
    {
        solver PBiCGStab; preconditioner DILU; tolerance 1e-9; relTol 0.1;
    }
}

relaxationFactors
{
    fields    { "p.*" 0.3; "pa.*" 0.3; }
    equations
    {
        "U.*"        0.5;
        "nuTilda.*"  0.3;
        "Ua.*"       0.4;
        "nuaTilda.*" 0.3;
        "yWall.*"    0.5;
        "da.*"       0.4;
    }
}
