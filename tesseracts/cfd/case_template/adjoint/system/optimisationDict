FoamFile { version 2.0; format ascii; class dictionary; object optimisationDict; }

optimisationManager  singleRun;

primalSolvers
{
    op1
    {
        active           true;
        type             incompressible;
        solver           simple;
        solutionControls
        {
            nNonOrthogonalCorrectors 2;
            nIters __PRIMAL_ITERS__;
            residualControl { "p.*" 1e-6; "U.*" 1e-6; "nuTilda.*" 1e-6; }
        }
    }
}

adjointManagers
{
    am1
    {
        primalSolver          op1;
        operatingPointWeight  1;
        adjointSolvers
        {
            adj
            {
                active                true;
                type                  incompressible;
                solver                adjointSimple;
                computeSensitivities  true;

                objectives
                {
                    type         incompressible;
                    objectiveNames
                    {
                        __OBJ__
                        {
                            weight     1.0;
                            type       force;
                            patches    (airfoil);
                            direction  __OBJ_DIR__;
                            Aref       1.0;
                            rhoInf     1.0;
                            UInf       60.0;
                        }
                    }
                }

                ATCModel
                {
                    ATCModel          standard;
                    extraConvection   0;
                    nSmooth           0;
                    zeroATCPatchTypes ();
                    maskType          faceCells;
                }

                solutionControls
                {
                    nNonOrthogonalCorrectors 2;
                    nIters __ADJ_ITERS__;
                    residualControl { "pa.*" 1e-8; "Ua.*" 1e-8; "nuaTilda.*" 1e-8; }
                }
            }
        }
    }
}

optimisation
{
    designVariables
    {
        sensitivityType      surfacePoints;
        patches              (airfoil);
        includeSurfaceArea   true;
        includeDistance      true;
        includeMeshMovement  true;
        writeAllSurfaceFiles true;
        adjointMeshMovementSolver { iters 1000; tolerance 1e-6; }
        adjointEikonalSolver      { iters 1000; tolerance 1e-6; epsilon 0.1; }
    }
}
