FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    residualControl { p 1e-8; U 1e-8; nuTilda 1e-8; }
}

solvers
{
    "(p|pa).*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-9;
        relTol          0.01;
    }
    "(m|ma)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-9;
        relTol          0.01;
    }
    "(U.*|Ua.*|nuTilda.*|nuaTilda.*|yWall|da)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.1;
    }
}

relaxationFactors
{
    fields
    {
        "p.*"        0.3;
        "pa.*"       0.3;
    }
    equations
    {
        "U.*"        0.7;
        "Ua.*"       0.7;
        "nuTilda.*"  0.7;
        "nuaTilda.*" 0.7;
        "yWall.*"    0.5;
        "da.*"       0.7;
    }
}
